--// ── Shake / flash helpers ───────────────────────────────────
local function shake(frame, intensity)
	intensity = intensity or 7
	local origin = frame.Position
	local pattern = { 0, -1, 1, -0.75, 0.75, -0.4, 0.4, -0.15, 0.15, 0 }
	for i, m in ipairs(pattern) do
		task.delay((i - 1) * 0.032, function()
			if frame.Parent then
				frame.Position = origin + UDim2.new(0, m * intensity, 0, 0)
			end
		end)
	end
	task.delay(#pattern * 0.032 + 0.02, function()
		if frame.Parent then frame.Position = origin end
	end)
end

local function flashStroke(stroke, color)
	stroke.Color = color
	tween(stroke, 0.7, { Color = STROKE })
end

local function setFeedback(text, color)
	feedback.Text = text
	feedback.TextColor3 = color or MUTED
end

--// ── Game detection ──────────────────────────────────────────
local function detectGame()
	local placeId = game.PlaceId
	local name = "Unknown Place"
	local creator = ""

	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(placeId, Enum.InfoType.Asset)
	end)
	if ok and info and info.Name then
		name = info.Name
		if info.Creator and info.Creator.Name then
			creator = info.Creator.Name
		end
	else
		local ok2, n = pcall(function() return game.Name end)
		if ok2 and n and n ~= "" then name = n end
	end

	gameName.Text = name
	if creator ~= "" then
		gameId.Text = "by " .. creator
	else
		gameId.Text = "Place ID: " .. tostring(placeId)
	end

	task.spawn(function()
		local universeId = getUniverseIdFromPlace(placeId)
		applyGameIcon(gameLogo, placeId, universeId)
	end)
end

