--// ── Helpers ─────────────────────────────────────────────────
local function create(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	inst.Parent = parent
	return inst
end

local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function label(props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.FontFace = FONT
	props.TextColor3 = props.TextColor3 or TEXT
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	return create("TextLabel", props)
end

local function sprite(parent, offset, color, size, position)
	return create("ImageLabel", {
		Size = size or UDim2.new(1, 0, 1, 0),
		Position = position or UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = SPRITE,
		ImageRectOffset = offset,
		ImageRectSize = Vector2.new(24, 24),
		ImageColor3 = color,
		ScaleType = Enum.ScaleType.Stretch,
		Parent = parent,
	})
end

local function bindHover(btn, enterProps, leaveProps)
	btn.MouseEnter:Connect(function() tween(btn, 0.15, enterProps) end)
	btn.MouseLeave:Connect(function() tween(btn, 0.15, leaveProps) end)
end

local function copyText(str)
	if setclipboard then
		local ok = pcall(setclipboard, str)
		if ok then return true end
	end
	if toclipboard then
		local ok = pcall(toclipboard, str)
		if ok then return true end
	end
	if syn and syn.write_clipboard then
		local ok = pcall(syn.write_clipboard, str)
		if ok then return true end
	end
	return false
end

--// ── Roblox asset fetch helpers ──────────────────────────────
local function httpGet(url)
	local ok, body = pcall(function() return game:HttpGet(url, true) end)
	if ok and type(body) == "string" and body ~= "" then return body end
	return nil
end

local function getUniverseIdFromPlace(placeId)
	local body = httpGet("https://apis.roblox.com/universes/v1/places/" .. tostring(placeId) .. "/universe")
	if body then
		local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
		if ok and data and (data.universeId or data.UniverseId) then
			return tonumber(data.universeId or data.UniverseId)
		end
	end

	local body2 = httpGet("https://api.roblox.com/universes/get-universe-from-place?placeId=" .. tostring(placeId))
	if body2 then
		local ok2, data2 = pcall(HttpService.JSONDecode, HttpService, body2)
		if ok2 and data2 and data2.UniverseId then
			return tonumber(data2.UniverseId)
		end
	end

	return nil
end

local function getGameIconViaThumbnailsApi(universeId)
	local body = httpGet(
		"https://thumbnails.roblox.com/v1/games/icons?universeIds="
		.. tostring(universeId)
		.. "&size=150x150&format=Png&isCircular=false"
	)
	if not body then return nil end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
	if not ok or not data or not data.data or not data.data[1] then return nil end
	local url = data.data[1].imageUrl
	if type(url) ~= "string" then return nil end
	local id = url:match("/(%d+)/") or url:match("id=(%d+)")
	if id then return tonumber(id) end
	return nil
end

local function buildGameIconCandidates(placeId, universeId)
	local list = {}

	if universeId then
		table.insert(list, "rbxthumb://type=GameIcon&id=" .. tostring(universeId) .. "&w=150&h=150")
	end

	table.insert(list, "rbxthumb://type=GameIcon&id=" .. tostring(placeId) .. "&w=150&h=150")

	if universeId then
		local id = getGameIconViaThumbnailsApi(universeId)
		if id then
			table.insert(list, "rbxassetid://" .. tostring(id))
		end
	end

	return list
end

local function applyGameIcon(imageLabel, placeId, universeId)
	local candidates = buildGameIconCandidates(placeId, universeId)

	task.spawn(function()
		for _, candidate in ipairs(candidates) do
			imageLabel.Image = candidate
			for _ = 1, 40 do
				if imageLabel.IsLoaded then return end
				task.wait(0.05)
			end
		end

		imageLabel.Image = GLOW
		imageLabel.ImageColor3 = ACCENT
		imageLabel.ImageTransparency = 0.2
		imageLabel.ScaleType = Enum.ScaleType.Stretch
	end)
end

