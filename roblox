--// ── Key submission ──────────────────────────────────────────
local submitting = false

local function submitKey()
	if submitting then return end

	local raw = textBox.Text or ""
	local key = raw:match("^%s*(.-)%s*$")

	if key == "" then
		notify("Missing key", "Please paste a license key before submitting.", WARN_C)
		setFeedback("Enter a license key first", WARN_C)
		shake(inputFrame)
		flashStroke(inputStroke, WARN_C)
		return
	end

	submitting = true
	setFeedback("Validating key...", MUTED)

	task.delay(0.45, function()
		notify(
			"Incorrect key",
			"\"" .. key:sub(1, 26) .. (key:len() > 26 and "..." or "") .. "\" is not a valid Airflow license key.",
			ERR_C
		)
		setFeedback("That key was rejected", ERR_C)
		shake(inputFrame, 9)
		flashStroke(inputStroke, ERR_C)
		submitting = false
	end)
end

submitBtn.MouseButton1Click:Connect(submitKey)

